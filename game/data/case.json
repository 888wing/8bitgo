 "RULEBOOK": {
  "r1": "只可以根據法庭上的證據作判斷；不可自行調查、不可閱讀案件報道、不可與外人討論案件。",
  "r2": "控方須證明被告有罪，至毫無合理疑點。有合理疑點，須判無罪。",
  "r3": "《司法效率條例》：每日休庭後暫議表決（有罪、無罪或未決）。任何一方達五票，即日裁決，審訊即時結束。",
  "r4": "法官指示忽略的說話，須在筆記上蓋「不予採納」；評議時不得引用。",
  "r5": "傳聞證據（轉述別人的說話）不可作為事實依據。",
  "r6": "最後一天的表決不設「未決」，只可以投有罪或無罪。",
  "r7": "替代罪名：如果不肯定被告犯謀殺罪，但肯定他放過火，可以裁定謀殺罪不成立、縱火罪成立。"
 },
 "PROLOGUE": [
  {
   "who": "旁白",
   "text": "一九八七年十一月，霧港西區。"
  },
  {
   "who": "旁白",
   "text": "信昌押落閘之前，閘門的信箱掉進一封信：高等法院，陪審員傳票。"
  },
  {
   "who": "母親",
   "text": "去成個禮拜？舖頭點算呀？"
  },
  {
   "who": "女兒",
   "text": "爸爸，陪審員係咪即係判人有冇罪㗎？"
  },
  {
   "who": "旁白",
   "text": "三日後，高等法院第七號法庭。書記從木箱裡抽出一個又一個名字。"
  },
  {
   "who": "書記",
   "text": "第七號陪審員。"
  },
  {
   "who": "旁白",
   "text": "你坐上陪審席最後一個位。"
  },
  {
   "who": "法官",
   "text": "各位陪審員，開始之前，有幾件事你哋要記住。"
  },
  {
   "who": "法官",
   "text": "第一，你哋只可以根據喺呢個法庭聽到、見到嘅證據作判斷。"
  },
  {
   "who": "法官",
   "text": "第二，控方要證明被告有罪，去到毫無合理疑點。有合理疑點，就要判無罪。"
  },
  {
   "who": "法官",
   "text": "第三，根據《司法效率條例》，每日休庭之後，你哋要暫議表決。任何一方有五票，就即日裁決，審訊即時結束。"
  },
  {
   "who": "法官",
   "text": "最後，我叫你哋忽略嘅說話，請你哋喺筆記上蓋「不予採納」。"
  },
  {
   "who": "旁白",
   "text": "庭警遞給你一本《陪審員須知》和一本筆記簿。證人講到重要的說法，你就會抄下來。"
  },
  {
   "who": "書記",
   "text": "被告何嘉樂，你被控三項謀殺罪。你承認定唔承認？"
  },
  {
   "who": "被告",
   "text": "……唔承認。"
  },
  {
   "who": "旁白",
   "text": "他二十二歲，比你想像中瘦。他望向陪審席，望向你。"
  },
  {
   "who": "控方",
   "text": "各位陪審員，十一月三日凌晨，福安樓三樓樓梯起火，三人死亡。"
  },
  {
   "who": "控方",
   "text": "控方會證明，係被告因為收樓糾紛，親手放嘅火。"
  }
 ],
